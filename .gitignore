# muxmesh — multi-machine tmux orchestrator (HTTP pivot).
/node_modules/
e2e/node_modules/

# Secret — NEVER committed (shared hub<->agents token)
token
*.token

# Runtime state generated by the hub (each machine has its own)
state.json
.muxmesh/

# Local config: we commit the template (config.toml.example), not the real copy
config.toml

# Binaires Linux pre-buildes : JAMAIS en git (13 MB de blobs).
# Survivent sur le disque pour Dockerfile.e2e.overlay (conteneur opencode,
# cleverrouille au build) ; git keep-ignore, .dockerignore ne les filtre pas.
bin-linux/
