<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- muxmesh-poll on macOS (the driver machine). Run the Linux equivalent under systemd elsewhere.
     Copy to ~/Library/LaunchAgents/ then:
       launchctl load ~/Library/LaunchAgents/com.muxmesh.poll.plist
     Replace USER with the real account name.
     MUXMESH_SOCKET must point at the SAME tmux server the terminal uses,
     otherwise the poller arms a phantom server and nothing is ever badged. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.muxmesh.poll</string>

  <key>ProgramArguments</key><array>
    <string>/Users/USER/dev/muxmesh/target/release/muxmesh-cli</string>
    <string>poll</string>
  </array>

  <key>EnvironmentVariables</key><dict>
    <key>MUXMESH_SOCKET</key><string>/private/tmp/tmux-501/default</string>
    <key>MUXMESH_STATE</key><string>/Users/USER/.muxmesh/state.json</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>

  <key>StandardOutPath</key><string>/Users/USER/.muxmesh/poll.out.log</string>
  <key>StandardErrorPath</key><string>/Users/USER/.muxmesh/poll.err.log</string>
</dict></plist>
