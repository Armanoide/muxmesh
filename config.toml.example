# muxmesh — shareable config template. Copy to ~/.config/muxmesh/config.toml on each machine.
#
# ATUIN RULE: this file is COMMIT-ABLE (no secrets). Every secret lives in
# its own 0600 file under ~/.config/muxmesh/:
#   token     — this machine's hub token (issued by pairing, never shared)
#   pair_key  — pairing secret, pasted once per new machine (hub + agent only)
#
#   cp config.toml.example ~/.config/muxmesh/config.toml

[hub]
# where muxmesh-hub listens on the always-on pivot machine. Trusted LAN only.
bind = "0.0.0.0:9997"
# where the hub writes the aggregated state (read by the poller and the status bar).
state_path = "~/.muxmesh/state.json"
# per-machine token registry written by the hub (digests + prefixes only,
# NEVER raw tokens). Env: MUXMESH_TOKENS.
tokens_path = "~/.muxmesh/tokens.json"
# pairing is OPEN while ~/.config/muxmesh/pair_key exists on both hub and
# agent (same content, mode 0600). No file => registration closed, the hub
# only accepts already-issued tokens. Generate: openssl rand -hex 16.

[poll]
# seconds between two poller passes (pgrep + state.json reads, zero network).
interval = 2
# freshness: an entry older than ttl (seconds) is considered offline.
ttl = 30

# Each remote machine (agent): its token comes from pairing, never shared.
# These values can be overridden by env (MUXMESH_HUB, MUXMESH_HOST, ...).
[agent]
# IP or hostname of the hub (the always-on pivot machine) to reach.
hub = "127.0.0.1"
port = 9997
# canonical name of THIS machine == what you type after `ssh` (host-a, or its
# LAN IP like 10.0.10.3). Leave empty => hostname -s. Set it explicitly if
# hostname != the token you type. Dots allowed (IPs).
host = ""
# seconds between two heartbeats pushed to the hub.
interval = 15
# local HTTP port where the agent serves POST /cmd (clients send closed-list
# commands here). 0 disables command execution. Env: MUXMESH_CMD_PORT.
cmd_port = 9998
# local tmux socket the agent controls ("" => tmux default). Env: MUXMESH_TMUX_SOCKET.
tmux_socket = ""
