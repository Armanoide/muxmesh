# keep the docker build context tiny: target/ is 5+ GB of host-built Rust
# artifacts (Linux-incompatible here anyway) and must never enter the context.
target/
.git/
.muxmesh/
node_modules/
*.log
state.json
token
*.token
config.toml
# NOTE : bin-linux/ est volontairement ABSENT de ce fichier — le build
# local du conteneur (overlay) en a besoin dans son contexte. Il nentre
# jamais dans git (voir .gitignore).
